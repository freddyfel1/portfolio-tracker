# Copy this file to ".env" (same folder) and fill in your own values.
# Get a Consumer Key / Consumer Secret by registering an app at
# https://developer.etrade.com — start with sandbox keys to test the
# connection safely before requesting production access.

ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=

# "sandbox" (fake test data) or "production" (your real accounts).
# Start on sandbox until the connection works end to end.
ETRADE_ENV=sandbox

# Port the local bridge listens on. Only change this if 8787 is
# already used by something else on your machine — and if you do,
# also update the port the tracker looks for under "Connected accounts".
PORT=8787
